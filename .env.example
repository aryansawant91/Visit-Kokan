# ==========================================
# VISIT KOKAN - ENVIRONMENT CONFIGURATION
# ==========================================

# Base Public App URL
NEXT_PUBLIC_APP_URL=https://visitkokan.in
NEXT_PUBLIC_SITE_URL=https://visitkokan.in

# Public Support & Contact Channels
NEXT_PUBLIC_SUPPORT_PHONE=+918432587706
NEXT_PUBLIC_WHATSAPP_NUMBER=918432587706
NEXT_PUBLIC_SUPPORT_EMAIL=hello@visitkokan.in

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Admin SDK (Server-Side)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...\n-----END PRIVATE KEY-----\n"

# Session & Cookie Security (HMAC Signing Secret)
SESSION_SECRET=your_32_character_random_hex_or_string_secret

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Email Service (Nodemailer / Gmail App Password or Resend)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# AI / LLM Trip Planner (Groq Cloud)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
